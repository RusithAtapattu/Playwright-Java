package pages;

import com.microsoft.playwright.Page;

public class LoginPage {

	private Page page;
	private final String usernameTextBox = "page.getByRole(AriaRole.TEXTBOX, new Page.GetByRoleOptions().setName(\"Username\"))";
	private final String passwordTextBox = "page.getByRole(AriaRole.TEXTBOX, new Page.GetByRoleOptions().setName(\"Password\"))";
	private final String loginButton = "page.getByRole(AriaRole.BUTTON, new Page.GetByRoleOptions().setName(\"Login\"))";

	public LoginPage(Page page) {
		this.page = page;
	}

	public void addUserName(String username) {
		page.fill(usernameTextBox, username);
	}

	public void addPassword(String password) {
		page.fill(passwordTextBox, password);
	}

	public void clickLoginButton() {
		page.click(loginButton);
	}
	
	public void login(String username, String password) {
		page.fill(usernameTextBox, username);
		page.fill(passwordTextBox, password);
		page.click(loginButton);
	}

}
